<%@page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="jakarta.tags.core"%><!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>NURSE - Inicio</title><link rel="stylesheet" href="${pageContext.request.contextPath}/Ccs/Style_GestionEnfermeria.css"></head><body><div class="app"><jsp:include page="/Vista/Componentes/SidebarEnfermeria.jsp"/><main class="contenido"><section class="pagina dashboard"><section class="encabezado"><div><h1>Hola, ${nombreEnfermera}</h1><p>${fechaActual}. Aquí tienes el resumen de tu jornada.</p></div><a class="btn-principal" href="${pageContext.request.contextPath}/Calendario">Ver agenda</a></section><c:if test="${pendientes > 0 or stockBajo > 0}"><section class="alertas"><c:if test="${pendientes > 0}"><div>⚠️ Tienes ${pendientes} ficha(s) pendiente(s) por completar.</div></c:if><c:if test="${stockBajo > 0}"><div>⚠️ Hay ${stockBajo} medicamento(s) con stock bajo.</div></c:if></section></c:if><section class="metricas dashboard-metricas"><article class="metrica azul"><div class="icono">♟</div><div><small>Pacientes registrados</small><strong>${totalPacientes}</strong></div></article><article class="metrica verde"><div class="icono verde">▤</div><div><small>Tratamientos activos</small><strong>${activos}</strong></div></article><article class="metrica rojo"><div class="icono rojo">✚</div><div><small>Medicamentos en inventario</small><strong>${totalMedicamentos}</strong></div></article></section><section class="dashboard-grid"><article class="panel proxima"><div class="panel-head"><h2>📅 Próxima visita</h2><a class="editar" href="${pageContext.request.contextPath}/Calendario">Agenda</a></div><c:choose><c:when test="${proximaCita != null}"><div class="visita"><span class="icono">◷</span><div><b>${proximaCita.pacienteNombre}</b><p>${proximaCita.tipo}</p><small>${proximaCita.fecha} · ${proximaCita.horaInicioTexto}</small></div></div></c:when><c:otherwise><p class="vacio">No tienes próximas visitas agendadas.</p></c:otherwise></c:choose></article><article class="panel resumen"><div class="panel-head"><h2>Resumen de tratamientos</h2></div><div class="barras"><div><span>Activos</span><b style="width:${activos + finalizados == 0 ? 0 : activos * 100 / (activos + finalizados)}%"></b><strong>${activos}</strong></div><div><span>Finalizados</span><b class="finalizado" style="width:${activos + finalizados == 0 ? 0 : finalizados * 100 / (activos + finalizados)}%"></b><strong>${finalizados}</strong></div></div></article><article class="panel actividad"><div class="panel-head"><h2>Actividad reciente</h2></div><c:forEach var="a" items="${actividad}"><div class="actividad-item"><span>●</span><div><b>${a.tipo}</b><p>${a.descripcion}</p><small>${a.fecha}</small></div></div></c:forEach><c:if test="${empty actividad}"><p class="vacio">Aún no hay actividad clínica registrada.</p></c:if></article><article class="panel accesos"><div class="panel-head"><h2>Accesos rápidos</h2></div><div><a class="btn-principal" href="${pageContext.request.contextPath}/GestionPacientesFormulario">Registrar paciente</a><a class="btn-principal" href="${pageContext.request.contextPath}/Calendario">Ver agenda</a><a class="btn-principal" href="${pageContext.request.contextPath}/GestionMedicamentos">Ver inventario</a></div></article></section></section></main></div></body></html>
