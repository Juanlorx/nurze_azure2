<%@page contentType="text/html" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Formulario de tratamiento | Nurse</title><link rel="stylesheet" href="${pageContext.request.contextPath}/Ccs/Style_GestionEnfermeria.css"></head><body><div class="app"><jsp:include page="/Vista/Componentes/SidebarEnfermeria.jsp"/><div class="contenido"><header class="barra"><div class="saludo"><b>Área de enfermería</b><span>Plan terapéutico</span></div><div class="perfil">● Sesión de enfermería</div></header><main class="pagina"><a class="btn-secundario" href="${pageContext.request.contextPath}/GestionTratamientos">← Volver a tratamientos</a><section class="form-card" style="margin-top:18px"><div class="form-cabecera"><div class="icono">▤</div><div><h1>${registroEditar != null ? 'Editar tratamiento' : 'Registrar tratamiento'}</h1><p>Asocia el tratamiento con su paciente y medicamentos.</p></div></div><form class="formulario" method="post" action="${pageContext.request.contextPath}/GestionTratamientos"><input type="hidden" name="accion" value="${registroEditar != null ? 'actualizar' : 'insertar'}"><input type="hidden" name="id" value="${registroEditar.id_Tratamiento}"><label class="campo-completo">Paciente<select name="paciente_id" required><option value="">Selecciona un paciente</option><c:forEach var="p" items="${listaPacientes}"><option value="${p.idPaciente}" ${registroEditar.pacienteId == p.idPaciente ? 'selected' : ''}>${p.nombreCompleto}</option></c:forEach></select></label><label class="campo-completo">Nombre o diagnóstico del tratamiento<input name="descripcion" value="${registroEditar.descripcion}" required></label><label>Inicio<input type="date" name="fecha_inicio" value="${registroEditar.fechaInicio}" required></label><label>Finalización<input type="date" name="fecha_fin" value="${registroEditar.fechaFin}" required></label><label>Estado<select name="estado" required><option value="Activo" ${registroEditar.estado == 'Activo' ? 'selected' : ''}>Activo</option><option value="Suspendido" ${registroEditar.estado == 'Suspendido' ? 'selected' : ''}>Suspendido</option><option value="Finalizado" ${registroEditar.estado == 'Finalizado' ? 'selected' : ''}>Finalizado</option></select></label><label>Indicaciones<textarea name="indicaciones" required>${registroEditar.indicaciones}</textarea></label><fieldset class="selector-medicamentos"><legend>Medicamentos asociados</legend><c:forEach var="m" items="${listaMedicamentos}"><label class="opcion-medicamento"><input type="checkbox" name="medicamento_id" value="${m.id_Medicamento}" ${registroEditar.tieneMedicamento(m.id_Medicamento) ? 'checked' : ''}><span><strong>${m.nombre}</strong> · ${m.presentacion}</span></label></c:forEach></fieldset><div class="acciones-form"><a class="btn-secundario" href="${pageContext.request.contextPath}/GestionTratamientos">Cancelar</a><button class="btn-principal" type="submit">Guardar tratamiento</button></div></form></section></main></div></div></body></html>
