<%@page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>NURSE - Ficha de paciente</title><link rel="stylesheet" href="${pageContext.request.contextPath}/Ccs/Style_GestionEnfermeria.css"></head><body><div class="app"><jsp:include page="/Vista/Componentes/SidebarEnfermeria.jsp"/><main class="contenido"><section class="pagina"><a class="btn-secundario" href="${pageContext.request.contextPath}/GestionPacientes">← Volver a pacientes</a><section class="perfil-paciente"><div class="avatar grande">${paciente.nombreCompleto.substring(0,1)}</div><div><span class="eyebrow">FICHA CLÍNICA</span><h1>${paciente.nombreCompleto}</h1><p>Documento ${paciente.identificacion} · Nacimiento ${paciente.fecha_nacimiento}</p></div><a class="editar" href="${pageContext.request.contextPath}/GestionPacientesFormulario?id=${paciente.idPaciente}">Editar datos básicos</a></section><div class="tabs" role="tablist"><button class="tab activo" data-tab="historial">Historial clínico</button><button class="tab" data-tab="signos">Signos vitales</button><button class="tab" data-tab="bitacora">Bitácora</button><button class="tab" data-tab="contacto">Contacto de emergencia</button></div><section id="historial" class="tab-panel activo"><div class="panel ficha-panel"><div class="panel-head"><h2>Historial clínico</h2><button class="btn-principal" data-form="form-historial">＋ Agregar al historial</button></div><div class="timeline"><c:forEach var="e" items="${eventos}"><article class="evento-clinico"><span class="punto"></span><b>${e.tipo}</b><small>${e.fecha} · ${e.enfermera}</small><p>${e.descripcion}</p></article></c:forEach><c:if test="${empty eventos}"><p class="vacio">Aún no hay eventos registrados.</p></c:if></div><form id="form-historial" class="formulario formulario-oculto" method="post"><input type="hidden" name="accion" value="historial"><input type="hidden" name="paciente_id" value="${paciente.idPaciente}"><label>Fecha y hora<input type="datetime-local" name="fecha_hora" required></label><label>Tipo<select name="tipo"><option>Diagnóstico</option><option>Evolución</option><option>Observación</option></select></label><label class="campo-completo">Descripción<textarea name="descripcion" required></textarea></label><button class="btn-principal">Guardar evento</button></form></div></section><section id="signos" class="tab-panel"><div class="panel ficha-panel"><div class="panel-head"><h2>Signos vitales</h2><button class="btn-principal" data-form="form-signos">＋ Registrar signos</button></div><div class="tabla-wrap"><table class="tabla"><thead><tr><th>Fecha</th><th>Presión</th><th>FC</th><th>Temp.</th><th>SpO₂</th><th>Glucosa</th></tr></thead><tbody><c:forEach var="s" items="${signos}"><tr><td>${s.fecha}</td><td>${s.presion}</td><td>${s.frecuencia}</td><td>${s.temperatura}</td><td>${s.saturacion}</td><td>${s.glucosa}</td></tr></c:forEach></tbody></table></div><form id="form-signos" class="formulario formulario-oculto" method="post"><input type="hidden" name="accion" value="signos"><input type="hidden" name="paciente_id" value="${paciente.idPaciente}"><label>Fecha y hora<input type="datetime-local" name="fecha_hora" required></label><label>Presión<input name="presion"></label><label>Frecuencia<input type="number" name="frecuencia"></label><label>Temperatura<input type="number" step="0.1" name="temperatura"></label><label>Saturación<input type="number" step="0.1" name="saturacion"></label><label>Glucosa<input type="number" step="0.1" name="glucosa"></label><button class="btn-principal">Guardar medición</button></form></div></section><section id="bitacora" class="tab-panel"><div class="panel ficha-panel"><div class="panel-head"><h2>Bitácora de enfermería</h2><button class="btn-principal" data-form="form-nota">＋ Agregar nota</button></div><div class="timeline"><c:forEach var="n" items="${notas}"><article class="evento-clinico"><span class="punto"></span><b>${n.enfermera}</b><small>${n.fecha}</small><p>${n.descripcion}</p></article></c:forEach></div><form id="form-nota" class="formulario formulario-oculto" method="post"><input type="hidden" name="accion" value="nota"><input type="hidden" name="paciente_id" value="${paciente.idPaciente}"><label>Fecha y hora<input type="datetime-local" name="fecha_hora" required></label><label class="campo-completo">Nota<textarea name="nota" required></textarea></label><button class="btn-principal">Guardar nota</button></form></div></section><section id="contacto" class="tab-panel"><div class="panel ficha-panel"><div class="panel-head"><h2>Contacto de emergencia</h2><button class="btn-principal" data-form="form-contacto">Editar contacto</button></div><div class="contacto-resumen"><b>${contacto.nombre}</b><p>${contacto.parentesco} · ${contacto.telefono}</p><p>${contacto.direccion}</p></div><form id="form-contacto" class="formulario formulario-oculto" method="post"><input type="hidden" name="accion" value="contacto"><input type="hidden" name="paciente_id" value="${paciente.idPaciente}"><label>Nombre<input name="nombre" value="${contacto.nombre}" required></label><label>Parentesco<input name="parentesco" value="${contacto.parentesco}" required></label><label>Teléfono<input name="telefono" value="${contacto.telefono}" required></label><label>Dirección<input name="direccion" value="${contacto.direccion}"></label><button class="btn-principal">Guardar contacto</button></form></div></section></section></main></div><script src="${pageContext.request.contextPath}/JavaScript/FichaPaciente.js"></script></body></html>
