<%@page contentType="text/html" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="jakarta.tags.core"%><c:set var="activos" value="0"/><c:set var="finalizados" value="0"/><c:forEach var="t" items="${listaTratamientos}"><c:if test="${t.estado == 'Activo'}"><c:set var="activos" value="${activos + 1}"/></c:if><c:if test="${t.estado == 'Finalizado'}"><c:set var="finalizados" value="${finalizados + 1}"/></c:if></c:forEach>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tratamientos | Nurse</title><link rel="stylesheet" href="${pageContext.request.contextPath}/Ccs/Style_GestionEnfermeria.css"></head><body><div class="app"><jsp:include page="/Vista/Componentes/SidebarEnfermeria.jsp"/><div class="contenido"><header class="barra"><div class="saludo"><b>Área de enfermería</b><span>Gestión clínica y seguimiento</span></div><div class="perfil">● Sesión de enfermería</div></header><main class="pagina"><section class="encabezado"><div><span class="eyebrow">PLAN TERAPÉUTICO</span><h1>Gestión de tratamientos</h1><p>Asocia tratamientos y medicamentos a cada paciente.</p></div><a class="btn-principal" href="${pageContext.request.contextPath}/GestionTratamientosFormulario">＋ Registrar nuevo</a></section><c:if test="${not empty sessionScope.mensajeGestion}"><div class="mensaje">${sessionScope.mensajeGestion}</div><c:remove var="mensajeGestion" scope="session"/></c:if><section class="metricas"><article class="metrica"><div class="icono">▤</div><div><small>Tratamientos totales</small><strong>${listaTratamientos.size()}</strong></div></article><article class="metrica"><div class="icono verde">✓</div><div><small>Tratamientos activos</small><strong>${activos}</strong></div></article><article class="metrica"><div class="icono rojo">●</div><div><small>Tratamientos finalizados</small><strong>${finalizados}</strong></div></article></section><section class="panel"><div class="panel-head"><h2>Seguimiento de tratamientos</h2><input class="buscador" data-filtro="tabla-tratamientos" type="search" placeholder="⌕ Buscar paciente o tratamiento"></div><div class="tabla-wrap"><table class="tabla" id="tabla-tratamientos"><thead><tr><th>Paciente</th><th>Tratamiento e indicaciones</th><th>Periodo</th><th>Medicamentos</th><th>Estado</th><th></th></tr></thead><tbody><c:forEach var="t" items="${listaTratamientos}"><tr><td><div class="persona"><span class="avatar">${t.pacienteNombre.substring(0,1)}</span><div><strong>${t.pacienteNombre}</strong><small>Paciente asignado</small></div></div></td><td class="celda-principal"><strong>${t.descripcion}</strong><small>${t.indicaciones}</small></td><td>${t.fechaInicio}<br><small>hasta ${t.fechaFin}</small></td><td>${empty t.medicamentosNombres ? 'Sin medicamentos' : t.medicamentosNombres}</td><td><span class="estado estado-${t.estado.toLowerCase()}">${t.estado}</span></td><td><a class="editar" href="${pageContext.request.contextPath}/GestionTratamientosFormulario?id=${t.id_Tratamiento}">Editar</a></td></tr></c:forEach></tbody></table></div></section></main></div></div><script src="${pageContext.request.contextPath}/JavaScript/GestionEnfermeria.js"></script></body></html>
