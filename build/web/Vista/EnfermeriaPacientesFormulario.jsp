<%@page contentType="text/html" pageEncoding="UTF-8"%>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Formulario de paciente | Nurse</title><link rel="stylesheet" href="${pageContext.request.contextPath}/Ccs/Style_GestionEnfermeria.css"></head><body><div class="app"><jsp:include page="/Vista/Componentes/SidebarEnfermeria.jsp"/><div class="contenido"><header class="barra"><div class="saludo"><b>Área de enfermería</b><span>Registro clínico</span></div><div class="perfil">● Sesión de enfermería</div></header><main class="pagina"><a class="btn-secundario" href="${pageContext.request.contextPath}/GestionPacientes">← Volver a pacientes</a><section class="form-card" style="margin-top:18px"><div class="form-cabecera"><div class="icono">♟</div><div><h1>${registroEditar != null ? 'Editar paciente' : 'Registrar paciente'}</h1><p>Completa los datos personales y el historial clínico.</p></div></div><form class="formulario" method="post" action="${pageContext.request.contextPath}/GestionPacientes"><input type="hidden" name="accion" value="${registroEditar != null ? 'actualizar' : 'insertar'}"><input type="hidden" name="id" value="${registroEditar.idPaciente}"><input type="hidden" name="usuario_id" value="${registroEditar.usuariosIdUsuarios}"><label>Nombres<input name="nombres" value="${usuarioEditar.nombres}" required></label><label>Apellidos<input name="apellidos" value="${usuarioEditar.apellidos}" required></label><label>Documento<input name="identificacion" value="${usuarioEditar.identificacion}" required></label><label>Fecha de nacimiento<input type="date" name="fecha_nacimiento" value="${registroEditar.fecha_nacimiento}" required></label><label>Teléfono<input name="telefono" value="${usuarioEditar.telefono}"></label><label>Correo<input type="email" name="correo" value="${usuarioEditar.correo}"></label><label class="campo-completo">Dirección<input name="direccion" value="${usuarioEditar.direccion}"></label><label class="campo-completo">Historial / diagnóstico<textarea name="historial" required>${registroEditar.diagnostico}</textarea></label><div class="acciones-form"><a class="btn-secundario" href="${pageContext.request.contextPath}/GestionPacientes">Cancelar</a><button class="btn-principal" type="submit">Guardar paciente</button></div></form></section></main></div></div></body></html>
