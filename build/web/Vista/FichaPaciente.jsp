<%@page contentType="text/html" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ficha clínica | Nurse</title><link rel="stylesheet" href="${pageContext.request.contextPath}/Ccs/Style_GestionEnfermeria.css"></head><body><div class="app"><jsp:include page="/Vista/Componentes/SidebarEnfermeria.jsp"/><main class="contenido"><section class="pagina"><a class="btn-secundario" href="${pageContext.request.contextPath}/GestionPacientes">← Pacientes</a><section class="form-card" style="margin-top:18px"><div class="form-cabecera"><div class="avatar">${paciente.nombreCompleto.substring(0,1)}</div><div><h1>${paciente.nombreCompleto}</h1><p>Documento: ${paciente.identificacion} · Nacimiento: ${paciente.fecha_nacimiento}</p></div><a class="editar" href="${pageContext.request.contextPath}/GestionPacientesFormulario?id=${paciente.idPaciente}">Editar datos básicos</a></div><details open><summary class="btn-secundario">Historial clínico</summary><c:forEach var="e" items="${eventos}"><p><b>${e.fecha} · ${e.tipo}</b><br>${e.descripcion}<small> — ${e.enfermera}</small></p></c:forEach><form class="formulario" method="post"><input type="hidden" name="accion" value="historial"><input type="hidden" name="paciente_id" value="${paciente.idPaciente}"><label>Fecha y hora<input type="datetime-local" name="fecha_hora" required></label><label>Tipo<select name="tipo"><option>Diagnóstico</option><option>Evolución</option><option>Observación</option></select></label><label class="campo-completo">Descripción<textarea name="descripcion" required></textarea></label><button class="btn-principal">Agregar al historial</button></form></details><details><summary class="btn-secundario">Signos vitales</summary><table class="tabla"><thead><tr><th>Fecha</th><th>Presión</th><th>FC</th><th>Temp.</th><th>SpO₂</th><th>Glucosa</th></tr></thead><tbody><c:forEach var="s" items="${signos}"><tr><td>${s.fecha}</td><td>${s.presion}</td><td>${s.frecuencia}</td><td>${s.temperatura}</td><td>${s.saturacion}</td><td>${s.glucosa}</td></tr></c:forEach></tbody></table><form class="formulario" method="post"><input type="hidden" name="accion" value="signos"><input type="hidden" name="paciente_id" value="${paciente.idPaciente}"><label>Fecha y hora<input type="datetime-local" name="fecha_hora" required></label><label>Presión<input name="presion"></label><label>Frecuencia<input name="frecuencia" type="number"></label><label>Temperatura<input name="temperatura" type="number" step="0.1"></label><label>Saturación<input name="saturacion" type="number" step="0.1"></label><label>Glucosa<input name="glucosa" type="number" step="0.1"></label><button class="btn-principal">Registrar signos</button></form></details><details><summary class="btn-secundario">Bitácora de enfermería</summary><c:forEach var="n" items="${notas}"><p><b>${n.fecha} · ${n.enfermera}</b><br>${n.descripcion}</p></c:forEach><form class="formulario" method="post"><input type="hidden" name="accion" value="nota"><input type="hidden" name="paciente_id" value="${paciente.idPaciente}"><label>Fecha y hora<input type="datetime-local" name="fecha_hora" required></label><label class="campo-completo">Nota<textarea name="nota" required></textarea></label><button class="btn-principal">Agregar nota</button></form></details><details><summary class="btn-secundario">Contacto de emergencia</summary><form class="formulario" method="post"><input type="hidden" name="accion" value="contacto"><input type="hidden" name="paciente_id" value="${paciente.idPaciente}"><label>Nombre<input name="nombre" value="${contacto.nombre}" required></label><label>Parentesco<input name="parentesco" value="${contacto.parentesco}" required></label><label>Teléfono<input name="telefono" value="${contacto.telefono}" required></label><label>Dirección<input name="direccion" value="${contacto.direccion}"></label><button class="btn-principal">Guardar contacto</button></form></details></section></section></main></div></body></html>
