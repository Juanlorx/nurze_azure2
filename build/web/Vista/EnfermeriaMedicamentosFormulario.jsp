<%@page contentType="text/html" pageEncoding="UTF-8"%>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Formulario de medicamento | Nurse</title><link rel="stylesheet" href="${pageContext.request.contextPath}/Ccs/Style_GestionEnfermeria.css"></head><body><div class="app"><jsp:include page="/Vista/Componentes/SidebarEnfermeria.jsp"/><div class="contenido"><header class="barra"><div class="saludo"><b>Área de enfermería</b><span>Inventario clínico</span></div><div class="perfil">● Sesión de enfermería</div></header><main class="pagina"><a class="btn-secundario" href="${pageContext.request.contextPath}/GestionMedicamentos">← Volver a medicamentos</a><section class="form-card" style="margin-top:18px"><div class="form-cabecera"><div class="icono">✚</div><div><h1>${registroEditar != null ? 'Editar medicamento' : 'Registrar medicamento'}</h1><p>Registra la información para el control de inventario.</p></div></div><form class="formulario" method="post" action="${pageContext.request.contextPath}/GestionMedicamentos"><input type="hidden" name="accion" value="${registroEditar != null ? 'actualizar' : 'insertar'}"><input type="hidden" name="id" value="${registroEditar.id_Medicamento}"><label>Nombre<input name="nombre" value="${registroEditar.nombre}" required></label><label>Uso terapéutico<input name="funcion" value="${registroEditar.funcion}" required></label><label>Presentación<input name="presentacion" value="${registroEditar.presentacion}" required></label><label>Lote<input name="lote" value="${registroEditar.lote}" required></label><label>Fecha de vencimiento<input type="date" name="fecha_vencimiento" value="${registroEditar.fechaVencimiento}" required></label><label>Existencias<input type="number" min="0" name="existencias" value="${registroEditar.existencias}" required></label><div class="acciones-form"><a class="btn-secundario" href="${pageContext.request.contextPath}/GestionMedicamentos">Cancelar</a><button class="btn-principal" type="submit">Guardar medicamento</button></div></form></section></main></div></div></body></html>
