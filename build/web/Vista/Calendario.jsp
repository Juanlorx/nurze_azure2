<%@page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>NURSE - Agenda</title><link rel="stylesheet" href="${pageContext.request.contextPath}/Ccs/Style_GestionEnfermeria.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/Ccs/Style_Calendario.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/Ccs/Style_AgendaFondo.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/Ccs/Style_AgendaFormulario.css"></head><body>
<jsp:include page="/Vista/Componentes/SidebarEnfermeria.jsp"/>
<main class="agenda"><section class="encabezado"><div><b>AGENDA DE ENFERMERÍA</b><h1>Organiza cada visita con claridad</h1><p>Programa atenciones, consulta horarios y evita cruces en la agenda.</p></div><button class="btn" type="button" id="abrir-cita">+ Agendar cita</button></section>
<c:if test="${not empty sessionScope.mensajeCita}"><div class="mensaje">${sessionScope.mensajeCita}</div><c:remove var="mensajeCita" scope="session"/></c:if>
<section class="agenda-grid"><div class="tarjeta calendario"><div class="calendario-header"><button type="button" onclick="cambiarMes(-1)">‹</button><div><h2>${nombreMes} ${anio}</h2><span>Vista mensual</span></div><button type="button" onclick="cambiarMes(1)">›</button></div><div class="semana"><span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span></div><div class="dias"><c:forEach begin="1" end="${espaciosIniciales}"><div class="dia vacio"></div></c:forEach><c:forEach begin="1" end="${diasMes}" var="dia"><div class="dia ${dia == hoyDia ? 'hoy' : ''}"><strong>${dia}</strong><c:forEach items="${agenda.citasDia(dia)}" var="cita"><div class="evento ${cita.estado == 'Cancelada' ? 'cancelada' : ''}"><b>${cita.horaInicioTexto}</b> ${cita.pacienteNombre}</div></c:forEach></div></c:forEach></div><p class="leyenda">● Cita programada &nbsp;&nbsp;<span>● Cita cancelada</span></p></div>
<aside class="tarjeta proximas"><h2>Citas del mes</h2><c:choose><c:when test="${empty agenda.citas}"><p class="vacio">No hay citas este mes.</p></c:when><c:otherwise><c:forEach items="${agenda.citas}" var="cita"><article class="resumen ${cita.estado == 'Cancelada' ? 'cancelada' : ''}"><div class="hora">${cita.horaInicioTexto}<small>${cita.horaFinTexto}</small></div><div><strong>${cita.pacienteNombre}</strong><p>${cita.tipo}</p><small>${cita.fecha} · ${cita.enfermeraNombre}</small></div><c:if test="${cita.estado != 'Cancelada'}"><form method="post"><input type="hidden" name="accion" value="cancelar"><input type="hidden" name="id" value="${cita.idCita}"><input type="hidden" name="anio" value="${anio}"><input type="hidden" name="mes" value="${mes}"><button class="cancelar" type="submit">×</button></form></c:if></article></c:forEach></c:otherwise></c:choose></aside></section>
<section class="tarjeta formulario formulario-cita-oculto" id="form-cita"><div><b>NUEVA CITA</b><h2>Programa una atención</h2><p>El sistema valida que una enfermera no tenga dos citas al mismo tiempo.</p></div><form method="post"><input type="hidden" name="anio" value="${anio}"><input type="hidden" name="mes" value="${mes}"><label>Paciente<select name="paciente_id" required><option value="">Selecciona un paciente</option><c:forEach items="${listaPacientes}" var="p"><option value="${p.idPaciente}">${p.nombreCompleto}</option></c:forEach></select></label><label>Enfermera<select name="enfermera_id" required><option value="">Selecciona una enfermera</option><c:forEach items="${listaEnfermeras}" var="e"><option value="${e.id_Enfermeras}">${e.nombreCompleto}</option></c:forEach></select></label><label>Tipo<select name="tipo" required><option>Consulta de enfermería</option><option>Visita domiciliaria</option><option>Control de tratamiento</option><option>Administración de medicamento</option></select></label><label>Fecha<input type="date" name="fecha" required></label><label>Hora de inicio<input type="time" name="hora_inicio" required></label><label>Hora de finalización<input type="time" name="hora_fin" required></label><label class="notas">Notas<textarea name="notas" placeholder="Indicaciones especiales, insumos o signos a revisar"></textarea></label><button class="btn guardar" type="submit">Confirmar cita</button></form></section></main>
<script>function cambiarMes(s){let a=${anio},m=${mes}+s;if(m===0){m=12;a--}if(m===13){m=1;a++}location.href='${pageContext.request.contextPath}/Calendario?anio='+a+'&mes='+m}document.getElementById('abrir-cita').onclick=function(){let f=document.getElementById('form-cita'),abierto=f.classList.contains('formulario-cita-oculto');f.classList.toggle('formulario-cita-oculto');this.textContent=abierto?'− Ocultar formulario':'+ Agendar cita';if(abierto)f.scrollIntoView({behavior:'smooth',block:'start'})}</script></body></html>
