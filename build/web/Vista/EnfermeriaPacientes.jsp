<%@page contentType="text/html" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="jakarta.tags.core"%><c:set var="pendientes" value="0"/><c:forEach var="p" items="${listaPacientes}"><c:if test="${empty p.diagnostico or p.diagnostico == 'Pendiente de completar'}"><c:set var="pendientes" value="${pendientes + 1}"/></c:if></c:forEach>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Pacientes | Nurse</title><link rel="stylesheet" href="${pageContext.request.contextPath}/Ccs/Style_GestionEnfermeria.css"></head><body><div class="app"><jsp:include page="/Vista/Componentes/SidebarEnfermeria.jsp"/><div class="contenido"><header class="barra"><div class="saludo"><b>Área de enfermería</b><span>Gestión clínica y seguimiento</span></div><div class="perfil">● Sesión de enfermería</div></header><main class="pagina"><section class="encabezado"><div><span class="eyebrow">REGISTRO CLÍNICO</span><h1>Gestión de pacientes</h1><p>Administra el registro y seguimiento de tus pacientes.</p></div><a class="btn-principal" href="${pageContext.request.contextPath}/GestionPacientesFormulario">＋ Registrar nuevo</a></section><c:if test="${not empty sessionScope.mensajeGestion}"><div class="mensaje">${sessionScope.mensajeGestion}</div><c:remove var="mensajeGestion" scope="session"/></c:if><section class="metricas"><article class="metrica"><div class="icono">♟</div><div><small>Pacientes registrados</small><strong>${listaPacientes.size()}</strong></div></article><article class="metrica"><div class="icono rojo">◷</div><div><small>Fichas por completar</small><strong>${pendientes}</strong></div></article><article class="metrica"><div class="icono verde">▥</div><div><small>Tratamientos registrados</small><strong>${listaTratamientos.size()}</strong></div></article></section><section class="panel"><div class="panel-head"><h2>Directorio de pacientes</h2><input class="buscador" data-filtro="tabla-pacientes" type="search" placeholder="⌕ Buscar por nombre o documento"></div><div class="tabla-wrap"><table class="tabla" id="tabla-pacientes"><thead><tr><th>Paciente</th><th>Documento</th><th>Fecha de nacimiento</th><th>Historial clínico</th><th>Estado</th><th></th></tr></thead><tbody><c:forEach var="p" items="${listaPacientes}"><tr><td><div class="persona"><span class="avatar">${p.nombreCompleto.substring(0,1)}</span><div><a class="nombre-paciente" href="${pageContext.request.contextPath}/FichaPaciente?id=${p.idPaciente}">${p.nombreCompleto}</a><small>Ver ficha clínica #${p.idPaciente}</small></div></div></td><td>${p.identificacion}</td><td>${p.fecha_nacimiento}</td><td>${p.diagnostico}</td><td><c:choose><c:when test="${empty p.diagnostico or p.diagnostico == 'Pendiente de completar'}"><span class="estado estado-pendiente">Pendiente</span></c:when><c:otherwise><span class="estado estado-activo">Completo</span></c:otherwise></c:choose></td><td><a class="editar" href="${pageContext.request.contextPath}/GestionPacientesFormulario?id=${p.idPaciente}">Editar</a></td></tr></c:forEach></tbody></table></div></section></main></div></div><script src="${pageContext.request.contextPath}/JavaScript/GestionEnfermeria.js"></script></body></html>
