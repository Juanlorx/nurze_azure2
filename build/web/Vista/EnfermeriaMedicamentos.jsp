<%@page contentType="text/html" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="jakarta.tags.core"%><c:set var="bajo" value="0"/><c:forEach var="m" items="${listaMedicamentos}"><c:if test="${m.existencias <= 10}"><c:set var="bajo" value="${bajo + 1}"/></c:if></c:forEach>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Medicamentos | Nurse</title><link rel="stylesheet" href="${pageContext.request.contextPath}/Ccs/Style_GestionEnfermeria.css"></head><body><div class="app"><jsp:include page="/Vista/Componentes/SidebarEnfermeria.jsp"/><div class="contenido"><header class="barra"><div class="saludo"><b>Área de enfermería</b><span>Gestión clínica y seguimiento</span></div><div class="perfil">● Sesión de enfermería</div></header><main class="pagina"><section class="encabezado"><div><span class="eyebrow">INVENTARIO CLÍNICO</span><h1>Gestión de medicamentos</h1><p>Registra y controla el inventario disponible para los tratamientos.</p></div><a class="btn-principal" href="${pageContext.request.contextPath}/GestionMedicamentosFormulario">＋ Registrar nuevo</a></section><c:if test="${not empty sessionScope.mensajeGestion}"><div class="mensaje">${sessionScope.mensajeGestion}</div><c:remove var="mensajeGestion" scope="session"/></c:if><section class="metricas"><article class="metrica"><div class="icono">✚</div><div><small>Medicamentos registrados</small><strong>${listaMedicamentos.size()}</strong></div></article><article class="metrica"><div class="icono rojo">!</div><div><small>Stock bajo (≤ 10)</small><strong>${bajo}</strong></div></article><article class="metrica"><div class="icono verde">▤</div><div><small>Tratamientos vinculados</small><strong>${listaTratamientos.size()}</strong></div></article></section><section class="panel"><div class="panel-head"><h2>Inventario de medicamentos</h2><input class="buscador" data-filtro="tabla-medicamentos" type="search" placeholder="⌕ Buscar medicamento o lote"></div><div class="tabla-wrap"><table class="tabla" id="tabla-medicamentos"><thead><tr><th>Medicamento</th><th>Uso terapéutico</th><th>Presentación</th><th>Lote</th><th>Vencimiento</th><th>Stock</th><th></th></tr></thead><tbody><c:forEach var="m" items="${listaMedicamentos}"><tr><td><div class="persona"><span class="avatar">${m.nombre.substring(0,1)}</span><div><strong>${m.nombre}</strong><small>Inventario clínico</small></div></div></td><td>${m.funcion}</td><td>${m.presentacion}</td><td>${m.lote}</td><td>${m.fechaVencimiento}</td><td><span class="estado ${m.existencias <= 10 ? 'stock-bajo' : 'stock-ok'}">${m.existencias} unidades</span></td><td><a class="editar" href="${pageContext.request.contextPath}/GestionMedicamentosFormulario?id=${m.id_Medicamento}">Editar</a></td></tr></c:forEach></tbody></table></div></section></main></div></div><script src="${pageContext.request.contextPath}/JavaScript/GestionEnfermeria.js"></script></body></html>
